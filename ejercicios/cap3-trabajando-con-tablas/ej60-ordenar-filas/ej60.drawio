<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="ej60" name="Ej 60 - Ordenar de menor a mayor cada fila de una matriz"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1648" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Ej. 60 · Ordenar de menor a mayor cada fila de una matriz  (Cap. 3, págs. 84-85 del libro)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="620" height="50" as="geometry"/></mxCell><mxCell id="vars" value="&lt;b&gt;Lista de variables&lt;/b&gt;&lt;br&gt;A(I,J) = matriz N×M&lt;br&gt;B = tope hasta donde se ordena&lt;br&gt;P = auxiliar para el intercambio" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="80" width="270" height="100" as="geometry"/></mxCell><mxCell id="n_a" value="Inicio" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="415" y="80" width="130" height="44" as="geometry"/></mxCell><mxCell id="n_b" value="Leer N, M y A(I,J)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="192" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_c" value="I = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="304" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_d" value="I = I + 1 ; B = M" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vert