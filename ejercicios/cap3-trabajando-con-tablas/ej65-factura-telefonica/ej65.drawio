<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="ej65" name="Ej 65 - Factura detallada de la compañía telefónica"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Ej. 65 · Factura detallada de la compañía telefónica  (Cap. 3, págs. 92-93 del libro)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="620" height="50" as="geometry"/></mxCell><mxCell id="vars" value="&lt;b&gt;Lista de variables&lt;/b&gt;&lt;br&gt;NC = nº de cliente&lt;br&gt;LA = lectura actual&lt;br&gt;L = pasos consumidos&lt;br&gt;T = total a pagar" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="80" width="270" height="120" as="geometry"/></mxCell><mxCell id="n_a" value="Inicio" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="415" y="80" width="130" height="44" as="geometry"/></mxCell><mxCell id="n_b" value="Cargar tabla de clientes C(I,1..5)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="192" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_c" value="Leer NC, LA" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="304" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_d" value="Buscar cliente NC en la tabla" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor