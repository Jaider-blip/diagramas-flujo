<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="ej50" name="Ej 50 - Búsqueda binaria en una lista ordenada"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1536" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Ej. 50 · Búsqueda binaria en una lista ordenada  (Cap. 3, págs. 74-75 del libro)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="620" height="50" as="geometry"/></mxCell><mxCell id="vars" value="&lt;b&gt;Lista de variables&lt;/b&gt;&lt;br&gt;A(I) = lista ordenada de N elementos&lt;br&gt;X = elemento buscado&lt;br&gt;Bajo, Alto, Medio = límites de la búsqueda" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="80" width="270" height="100" as="geometry"/></mxCell><mxCell id="n_a" value="Inicio" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="415" y="80" width="130" height="44" as="geometry"/></mxCell><mxCell id="n_b" value="Leer N y la lista A(1..N) ordenada" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="192" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_c" value="Leer elemento X a buscar" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="304" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_d" value="Bajo = 1 ; Alto = N" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="416" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_e" value="Bajo ≤ Alto ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="528" width="210" height="90" as="geometry"/></mxCell><mxCell id="n_f" value="Medio = (Bajo + Alto) / 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="640" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_g" value="A(Medio) = X ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="752" width="210" height="90" as="geometry"/></mxCell><mxCell id="n_g1" value="Escribir «Encontrado en posición Medio»" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="675" y="752" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_h" value="X &lt; A(Medio) ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="864" width="210" height="90" as="geometry"/></mxCell><mxCell id="n_h1" value="Alto = Medio − 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="75" y="864" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_h2" value="Bajo = Medio + 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="675" y="864" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_k" value="Escribir «No existe el elemento buscado»" style="shape=parallelogram;perim