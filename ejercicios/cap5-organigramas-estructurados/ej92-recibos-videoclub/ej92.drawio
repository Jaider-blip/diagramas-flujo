<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="ej92" name="Ej 92 - Recibos de un videoclub (estructurado)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1424" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Ej. 92 · Recibos de un videoclub (estructurado)  (Cap. 5, págs. 190-191 del libro)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="620" height="50" as="geometry"/></mxCell><mxCell id="vars" value="&lt;b&gt;Lista de variables&lt;/b&gt;&lt;br&gt;M(I,1..5) = nombre, dirección, teléfono, películas, cuota&lt;br&gt;P = películas del socio&lt;br&gt;C50 = socios con más de 50 películas" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="80" width="270" height="100" as="geometry"/></mxCell><mxCell id="n_a" value="Inicio" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="415" y="80" width="130" height="44" as="geometry"/></mxCell><mxCell id="n_b" value="Leer N y la matriz M(I,1..5)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="192" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_c" value="I = 0 ; C50 = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="304" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_d" value="I = I + 1 ; P = M(I,4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="416" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_e" value="Pel = 100·mín(P,20) + 75·mín(máx(P−20,0),30) + 50·máx(P−50,0)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="528" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_f" value="Recibo = M(I,5) + Pel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="640" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_g" value="P &gt; 50 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="752" width="210" height="90" as="geometry"/></mxCell><mxCell id="n_g1" value="C50 = C50 + 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="675" y="752" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_h" value="Escribir recibo: nombre, películas, importe" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="864" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_i" value="I = N ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="976" width="210" height="90" as="geometry"/></mxCell><mxCell id="n_j" value="Escribir «Socios con más de 50 películas: C50»" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="1088" width="210" height="54" as="geometry"/></mxCell><mxCell id="n_k" value="Fi